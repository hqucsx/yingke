<Window x:Class="YingKe.App.Capture.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="映刻 截图"
        WindowStyle="None"
        Background="#FF000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True"
        Cursor="Cross"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="Scene">
        <!-- 冻结画面（先于遮罩捕获，因此遮罩不会污染结果） -->
        <Image x:Name="FrozenImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

        <!-- 四块半透明遮罩围出选区 -->
        <Rectangle x:Name="MaskTop" Fill="#66000000"/>
        <Rectangle x:Name="MaskLeft" Fill="#66000000"/>
        <Rectangle x:Name="MaskRight" Fill="#66000000"/>
        <Rectangle x:Name="MaskBottom" Fill="#66000000"/>

        <Rectangle x:Name="SelectionBorder" Stroke="#1E9FFF" StrokeThickness="1"/>

        <!-- 选区调整手柄（8 向）：位置由 UpdateSelectionVisuals 驱动 -->
        <Canvas x:Name="HandleLayer" IsHitTestVisible="False" Visibility="Hidden">
            <Rectangle x:Name="HandleNW" Width="8" Height="8" Fill="White" Stroke="#1E9FFF" StrokeThickness="1"/>
            <Rectangle x:Name="HandleN" Width="8" Height="8" Fill="White" Stroke="#1E9FFF" StrokeThickness="1"/>
            <Rectangle x:Name="HandleNE" Width="8" Height="8" Fill="White" Stroke="#1E9FFF" StrokeThickness="1"/>
            <Rectangle x:Name="HandleW" Width="8" Height="8" Fill="White" Stroke="#1E9FFF" StrokeThickness="1"/>
            <Rectangle x:Name="HandleE" Width="8" Height="8" Fill="White" Stroke="#1E9FFF" StrokeThickness="1"/>
            <Rectangle x:Name="HandleSW" Width="8" Height="8" Fill="White" Stroke="#1E9FFF" StrokeThickness="1"/>
            <Rectangle x:Name="HandleS" Width="8" Height="8" Fill="White" Stroke="#1E9FFF" StrokeThickness="1"/>
            <Rectangle x:Name="HandleSE" Width="8" Height="8" Fill="White" Stroke="#1E9FFF" StrokeThickness="1"/>
        </Canvas>

        <!-- 原位标注层（PRD F-30）：底图裁剪 + 标注图形，导出时整体压平。
             IsHitTestVisible=False：鼠标统一由窗口级处理器路由。
             AnnotationRenderRoot 必须保持零偏移：RTB.Render 会连 VisualOffset 一起渲染。 -->
        <Canvas x:Name="AnnotationHost" ClipToBounds="True" IsHitTestVisible="False" Visibility="Hidden">
            <Canvas x:Name="AnnotationRenderRoot">
                <Image x:Name="AnnotationBaseImage" Stretch="Fill"/>
                <Canvas x:Name="ShapesCanvas"/>
            </Canvas>
        </Canvas>

        <!-- 尺寸角标（物理像素） -->
        <Border x:Name="SizeBadge" Background="#E6202020" CornerRadius="3" Padding="6,2" Visibility="Hidden">
            <TextBlock x:Name="SizeBadgeText" Foreground="White" FontSize="12"/>
        </Border>

        <!-- 悬浮工具栏：动作行 + 标注工具行 + 颜色/字号行，均带快捷键提示 -->
        <Border x:Name="Toolbar" Background="#F0202020" CornerRadius="6" Padding="10,7" Visibility="Collapsed">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Click="OnExtractTextClicked"
                            ToolTip="识别选区内的文字，自动复制到剪贴板">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="取字"/><TextBlock Text="{Binding OcrKeyText}" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnAiVisionClicked"
                            ToolTip="用 AI 理解/描述选区内容（需在设置中配置 API Key）">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="AI识图"/><TextBlock Text="{Binding AiKeyText}" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnTranslateClicked"
                            ToolTip="识别选区文字并翻译（自动判断中英方向）">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="翻译"/><TextBlock Text="{Binding TranslateKeyText}" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnPinClicked"
                            ToolTip="把选区截图钉在屏幕上，可拖动/缩放/调透明度">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="钉图"/><TextBlock Text="{Binding PinKeyText}" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnCopyClicked"
                            ToolTip="复制选区图片到剪贴板并关闭截图">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="复制"/><TextBlock Text="{Binding CopyKeyText}" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnSaveClicked"
                            ToolTip="把选区保存为图片文件（PNG/JPEG）">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="保存"/><TextBlock Text="{Binding SaveKeyText}" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnCancelClicked"
                            ToolTip="放弃本次截图">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="取消"/><TextBlock Text=" Esc" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <TextBlock Text="Enter 也可复制" Foreground="#90FFFFFF" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="ToolRow" Orientation="Horizontal" Margin="0,7,0,0">
                    <TextBlock Text="标注" Foreground="#90FFFFFF" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Tag="Rectangle" Style="{StaticResource ToolButton}" Click="OnToolClicked" ToolTip="绘制矩形标注">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="矩形"/><TextBlock Text=" R" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Tag="Ellipse" Style="{StaticResource ToolButton}" Click="OnToolClicked" ToolTip="绘制椭圆标注">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="椭圆"/><TextBlock Text=" O" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Tag="Arrow" Style="{StaticResource ToolButton}" Click="OnToolClicked" ToolTip="绘制箭头指示">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="箭头"/><TextBlock Text=" A" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Tag="Pen" Style="{StaticResource ToolButton}" Click="OnToolClicked" ToolTip="自由画笔涂画">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="画笔"/><TextBlock Text=" D" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Tag="Text" Style="{StaticResource ToolButton}" Click="OnToolClicked" ToolTip="在选区内点击位置输入文字（字号见下方）">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="文字"/><TextBlock Text=" T" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Tag="Number" Style="{StaticResource ToolButton}" Click="OnToolClicked" ToolTip="点击位置添加数字序号（自动递增）">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="序号"/><TextBlock Text=" N" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Tag="Mosaic" Style="{StaticResource ToolButton}" Click="OnToolClicked" ToolTip="涂抹马赛克遮盖敏感信息">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="马赛克"/><TextBlock Text=" M" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Tag="Blur" Style="{StaticResource ToolButton}" Click="OnToolClicked" ToolTip="高斯模糊遮盖选区内容">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="模糊"/><TextBlock Text=" B" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Tag="Magnifier" Style="{StaticResource ToolButton}" Click="OnToolClicked" ToolTip="放大镜查看像素细节（含取色）">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="放大"/><TextBlock Text=" U" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="OnUndoClicked" ToolTip="撤销上一步标注">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="撤销"/><TextBlock Text=" Z" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnClearClicked" ToolTip="清空全部标注">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="清空"/><TextBlock Text=" X" Foreground="#80FFFFFF" FontSize="11"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <TextBlock Text="颜色" Foreground="#90FFFFFF" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Tag="#FFFF3B30" Width="18" Height="18" CornerRadius="9" Background="#FF3B30"
                            Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Margin="0,0,6,0"
                            BorderThickness="2" BorderBrush="White"/>
                    <Border Tag="#FFFF9500" Width="18" Height="18" CornerRadius="9" Background="#FF9500"
                            Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Margin="0,0,6,0"
                            BorderThickness="2" BorderBrush="Transparent"/>
                    <Border Tag="#FFFFCC00" Width="18" Height="18" CornerRadius="9" Background="#FFCC00"
                            Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Margin="0,0,6,0"
                            BorderThickness="2" BorderBrush="Transparent"/>
                    <Border Tag="#FF34C759" Width="18" Height="18" CornerRadius="9" Background="#34C759"
                            Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Margin="0,0,6,0"
                            BorderThickness="2" BorderBrush="Transparent"/>
                    <Border Tag="#FF1E9FFF" Width="18" Height="18" CornerRadius="9" Background="#1E9FFF"
                            Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Margin="0,0,6,0"
                            BorderThickness="2" BorderBrush="Transparent"/>
                    <Border Tag="#FFAF52DE" Width="18" Height="18" CornerRadius="9" Background="#AF52DE"
                            Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Margin="0,0,6,0"
                            BorderThickness="2" BorderBrush="Transparent"/>
                    <Border Tag="#FFFFFFFF" Width="18" Height="18" CornerRadius="9" Background="#FFFFFF"
                            Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Margin="0,0,6,0"
                            BorderThickness="2" BorderBrush="Transparent"/>
                    <Border Tag="#FF141414" Width="18" Height="18" CornerRadius="9" Background="#141414"
                            Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Margin="0,0,6,0"
                            BorderThickness="2" BorderBrush="Transparent" ToolTip="黑色"/>
                    <Border x:Name="CustomColorSwatch" Width="18" Height="18" CornerRadius="9" Background="#40FFFFFF"
                            Cursor="Hand" MouseLeftButtonDown="OnCustomColorClicked" ToolTip="更多颜色…"
                            BorderThickness="2" BorderBrush="Transparent">
                        <TextBlock Text="＋" FontSize="10" Foreground="#DDDDDD" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <TextBlock Text="字号" Foreground="#90FFFFFF" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <ComboBox x:Name="FontSizeCombo" Width="70" FontSize="12" SelectedIndex="2"
                              SelectionChanged="OnFontSizeChanged">
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="28"/>
                        <ComboBoxItem Content="36"/>
                    </ComboBox>
                </StackPanel>
                <!-- 扩展调色板：作为工具栏内独立一行展开（Popup 在跨屏 DPI 虚拟坐标系下定位不可靠，已弃用） -->
                <WrapPanel x:Name="PalettePanel" MaxWidth="520" Margin="40,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- 取色放大镜（PRD F-03） -->
        <Border x:Name="Magnifier" Background="White" BorderBrush="#333333" BorderThickness="1"
                CornerRadius="3" Visibility="Hidden">
            <StackPanel>
                <Image x:Name="MagnifierImage" Width="136" Height="136" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="1"/>
                <TextBlock x:Name="MagnifierInfo" FontSize="11" Foreground="#222222" Padding="4,2,4,3"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
