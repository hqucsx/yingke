<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\YingKe.Core\YingKe.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <AssemblyName>YingKe</AssemblyName>
    <RootNamespace>YingKe.App</RootNamespace>
    <Version>0.1.1</Version>
    <AssemblyTitle>映刻</AssemblyTitle>
    <Product>映刻</Product>
    <Company>映刻</Company>
    <Copyright>Copyright © 映刻</Copyright>
    <Description>映刻 - AI 原生截图工具</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>yingke.ico</ApplicationIcon>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="yingke.ico" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
